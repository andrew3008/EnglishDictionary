# HELM authority — Agent bootstrap only (no Spring writer).
# Mount as container env / JVM -D equivalents. Restart to change.
# Final names only — no legacy aliases.

PLATFORM_TRACING_CONFIGURATION_AUTHORITY=HELM
PLATFORM_TRACING_MODE=AGENT
PLATFORM_ENVIRONMENT=PRODUCTION

# Category A bootstrap (Agent parser; not Config Server policy.* namespace)
PLATFORM_TRACING_SAMPLING_ENABLED=true
PLATFORM_TRACING_SAMPLING_RATIO=0.1
PLATFORM_TRACING_VALIDATION_ENABLED=true
PLATFORM_TRACING_VALIDATION_STRICT=false

# Category B — final javaagent.* names (startup-only; restart required)
PLATFORM_TRACING_JAVAAGENT_SCRUBBING_ENABLED=true
PLATFORM_TRACING_JAVAAGENT_SAMPLING_DROP_PATHS=/actuator/health,/actuator/prometheus,/actuator/info
PLATFORM_TRACING_JAVAAGENT_SAMPLING_FORCE_RECORD_VALUES=on
PLATFORM_TRACING_JAVAAGENT_PROPAGATION_BAGGAGE_ENABLED=true

# Equivalent -D forms (illustrative):
# -Dplatform.tracing.configuration.authority=HELM
# -Dplatform.tracing.javaagent.scrubbing.enabled=true
# -Dplatform.tracing.javaagent.sampling.drop-paths=/actuator/health,/actuator/prometheus,/actuator/info
