+/**
+ * Slice 0: нормативный wire-контракт шести domain-level JMX observation-членов.
+ *
+ * <p>Это единственный источник истины для имён {@code CompositeType}, имён item'ов,
+ * версии схемы и классификации ключей динамических карт на стороне агента.
+ * Модуль {@code platform-tracing-spring-boot-autoconfigure} держит независимую
+ * копию этих же констант (другой classloader, общий Java-тип невозможен) в
+ * {@code space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.observation}.
+ * Совпадение значений проверяется independent-verification тестами на каждой
+ * стороне (см. ADR по absent-owner encoding), а не tautological parity-тестом,
+ * который сверял бы одну и ту же константу с самой собой.
+ *
+ * <p>Класс не содержит логики кодирования/декодирования — он фиксирует нормативные
+ * имена и классификацию, которыми обязаны пользоваться конструкторы
+ * {@code CompositeType}/{@code TabularType} на агентской стороне и декодеры на
+ * стороне {@code *JmxView}.
+ */
+public final class JmxObservationWireContract {
+
+    /**
+     * Текущая версия схемы всех шести observation-членов. Повышается при любом breaking-изменении.
+     *
+     * <p>v2: {@code Sampling}/{@code Scrubbing}/{@code Validation} перешли с sentinel-значений
+     * ({@code -1L}, {@code "unknown"}) на presence-дискриминатор ({@code ownerPresent}/
+     * {@code ownerGeneration}) — тот же приём, что уже применялся в {@code Export} и
+     * {@code ProcessorMetrics} в v1. {@code Diagnostics} не менялся: его источники — статические
+     * синглтоны без reset, presence для них константна.
+     */
+    public static final int SCHEMA_VERSION = 2;
+
+    private JmxObservationWireContract() {
+    }
+
+    // -- Общий каркас (frame), одинаковый для всех шести observation-членов ---
+
+    /** {@code SimpleType.INTEGER}. */
+    public static final String ITEM_SCHEMA_VERSION = "schemaVersion";
+
+    /** {@code SimpleType.LONG}; per-MBean монотонный счётчик захвата, diagnostic invariant, не участвует в ordering registry. */
+    public static final String ITEM_CAPTURE_SEQUENCE = "captureSequence";
+
+    /** {@code SimpleType.STRING}; каноническая форма {@link java.util.UUID}. */
+    public static final String ITEM_AGENT_INSTANCE_ID = "agentInstanceId";
+
+    /** {@code SimpleType.LONG}; epoch millis. */
+    public static final String ITEM_CAPTURE_STARTED_AT = "captureStartedAt";
+
+    /** {@code SimpleType.LONG}; epoch millis, {@code >= captureStartedAt}. */
+    public static final String ITEM_CAPTURE_COMPLETED_AT = "captureCompletedAt";
+
+    // -- Каркас per-owner sub-composite ----------------------------------------
+
+    /** {@code SimpleType.BOOLEAN}. */
+    public static final String ITEM_OWNER_PRESENT = "ownerPresent";
+
+    /** {@code SimpleType.LONG}; положительное при {@code ownerPresent = true}, сохраняется при {@code Absent}. */
+    public static final String ITEM_OWNER_GENERATION = "ownerGeneration";
+
+    /** {@code SimpleType.LONG}; наносекундное смещение capture владельца от {@code captureStartedAt}. */
+    public static final String ITEM_OWNER_CAPTURED_OFFSET_NANOS = "ownerCapturedOffsetNanos";
+
+    /** Классификация мощности ключей динамической {@code TabularData}-карты. */
+    public enum KeyCardinality {
+
+        /** Ключи — значения закрытого enum; допустимо отображение в отдельный meter на ключ. */
+        FIXED_ENUM,
+
+        /** Ключи — конечный, явно ревьюженный allowlist имён; допустимо отображение в meter через allowlist. */
+        BOUNDED_ALLOWLIST,
+
+        /** Ключи потенциально неограничены; в Micrometer-тег превращать запрещено, только агрегат/`tracingStatus`. */
+        DYNAMIC_NOT_EXPORTED
+    }
+
+    /** Семантический тип значения ключа внутри динамической карты. */
+    public enum ValueSemantics {
+
+        /** Монотонно неубывающее значение с момента появления владельца; проходит через {@code MonotonicJmxCounterGroupBridge}. */
+        CUMULATIVE,
+
+        /** Значение в текущий момент; экспортируется как gauge, через монотонный bridge не проходит. */
+        POINT_IN_TIME
+    }
+
+    public record DynamicMapKey(String key, KeyCardinality cardinality, ValueSemantics semantics) {
+    }
