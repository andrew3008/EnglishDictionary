@@ -0,0 +1,28 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+/**
+ * Стабильные коды типов wire-значения для {@link JmxContractViolation#expectedType()} и
+ * {@link JmxContractViolation#actualType()}. Имя Java-класса полученного значения
+ * (например, {@code java.lang.String}) схемой не является и наружу не публикуется —
+ * только эти закрытые коды.
+ */
+public enum JmxWireTypeCode {
+
+    SCALAR_LONG,
+    SCALAR_INTEGER,
+    SCALAR_DOUBLE,
+    SCALAR_BOOLEAN,
+    SCALAR_STRING,
+    STRING_LONG_MAP,
+    STRING_DOUBLE_MAP,
+    STRING_ARRAY,
+    COMPOSITE_DATA,
+    TABULAR_DATA,
+
+    /** Значение синтаксически корректного типа, но карта содержит хотя бы один элемент неверного типа. */
+    MAP_WITH_NON_LONG_VALUE,
+    MAP_WITH_NON_STRING_KEY,
+
+    NULL,
+    UNKNOWN
+}
diff --git a/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/metrics/MonotonicJmxCounterGroupBridge.java b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/metrics/MonotonicJmxCounterGroupBridge.java
new file mode 100644
index 00000000..1afc1ba3
--- /dev/null
+++ b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/metrics/MonotonicJmxCounterGroupBridge.java
@@ -0,0 +1,203 @@
+package space.br1440.platform.tracing.autoconfigure.metrics;
+
+import java.lang.management.ManagementFactory;
+import java.util.EnumMap;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.LongAdder;
+import java.util.concurrent.locks.ReentrantLock;
+import java.util.function.Supplier;
+
+import space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.JmxOwnerState;
+
+/**
+ * Владелец-уровневый мост между одним JMX-владельцем, отдающим несколько cumulative-значений
+ * (5-7 ключей на владельца), и Micrometer {@code FunctionCounter}. Один observation обрабатывается
+ * целиком: отдельный bridge на каждый meter означал бы N JMX-захватов одного владельца за один
+ * scrape и N-кратное обнаружение одной и той же смены владельца.
+ *
+ * <p><b>Идентичность источника:</b> смена владельца определяется парой (agentInstanceId, generation).
+ * {@code generation} приходит из decode-контракта ({@link JmxOwnerState}) и меняется при каждой
+ * пере-регистрации MBean-владельца внутри одного процесса. {@code agentInstanceId} в текущем wire-
+ * контракте шести доменов не публикуется, поэтому по умолчанию используется process-scoped значение
+ * ({@link java.lang.management.RuntimeMXBean#getName()}, стабильное на весь жизненный цикл JVM).
+ * Ветка {@link ResetCause#AGENT_INSTANCE_CHANGED} в java-agent-топологии in-process недостижима —
+ * bridge и процесс агента создаются и уничтожаются вместе — и сохраняется как защитная: она
+ * покрывает пересоздание Spring-контекста без перезапуска JVM с иным {@code agentInstanceIdSupplier},
+ * а также будущее появление {@code agentInstanceId} на wire без изменения этого класса. Тестируется
+ * только прямой подачей отличающегося {@code agentInstanceId} в bridge, не через живой JMX-transport.
+ *
+ * <p>Состояние — неизменяемый {@link BridgeSnapshot} в {@code volatile}-поле. {@link #count(Enum)}
+ * при устаревшем снимке пытается {@link ReentrantLock#tryLock()}: победитель выполняет JMX-чтение
+ * и декодирование под локом и публикует новый снимок, проигравшие и опоздавшие не ждут и
+ * возвращают последний опубликованный снимок. Refresh никогда не выполняется параллельно для
+ * одного владельца; медленный владелец не задерживает другие bridge и другие потоки scrape.
+ *
+ * <p>Coalescing-окно на injected {@link Ticker} объединяет вызовы одного scrape: Micrometer не
+ * даёт универсального {@code scrapeId}, поэтому без окна каждый {@code FunctionCounter} одного
+ * владельца инициировал бы отдельный JMX-capture.
+ *
+ * @param <K> закрытое enum-пространство cumulative-ключей одного владельца
+ */
+final class MonotonicJmxCounterGroupBridge<K extends Enum<K>> {
+
+    /** Process-scoped значение по умолчанию для {@code agentInstanceId} — см. класс-javadoc. */
+    static final Supplier<String> LOCAL_PROCESS_IDENTITY = ManagementFactory.getRuntimeMXBean()::getName;
+
+    private static final long DEFAULT_COALESCING_WINDOW_NANOS = 150_000_000L;
+    private static final long NEVER_OBSERVED_GENERATION = -1L;
+
+    /** Причина реcета накопленного состояния владельца — тег {@code cause} у {@code source_resets_total}. */
+    enum ResetCause {
+        OWNER_REPLACED,
+        AGENT_INSTANCE_CHANGED
+    }
+
+    @FunctionalInterface
+    interface Ticker {
+        long nanoTime();
+    }
+
+    private final Class<K> keyType;
+    private final Supplier<Optional<JmxOwnerState<Map<K, Long>>>> source;
+    private final Supplier<String> agentInstanceId;
+    private final Ticker ticker;
+    private final long coalescingWindowNanos;
+    private final ReentrantLock refreshLock = new ReentrantLock();
+    private final Map<K, LongAdder> anomalyCounts;
+    private final Map<ResetCause, LongAdder> resetCounts;
+
+    private volatile BridgeSnapshot<K> snapshot;
+
+    MonotonicJmxCounterGroupBridge(
+            Class<K> keyType,
+            Supplier<Optional<JmxOwnerState<Map<K, Long>>>> source,
+            Ticker ticker) {
+        this(keyType, source, LOCAL_PROCESS_IDENTITY, ticker, DEFAULT_COALESCING_WINDOW_NANOS);
+    }
+
+    MonotonicJmxCounterGroupBridge(
+            Class<K> keyType,
+            Supplier<Optional<JmxOwnerState<Map<K, Long>>>> source,
+            Supplier<String> agentInstanceId,
+            Ticker ticker,
+            long coalescingWindowNanos) {
+        this.keyType = keyType;
+        this.source = source;
+        this.agentInstanceId = agentInstanceId;
+        this.ticker = ticker;
+        this.coalescingWindowNanos = coalescingWindowNanos;
+        this.anomalyCounts = new EnumMap<>(keyType);
+        for (K key : keyType.getEnumConstants()) {
+            anomalyCounts.put(key, new LongAdder());
+        }
+        this.resetCounts = new EnumMap<>(ResetCause.class);
+        for (ResetCause cause : ResetCause.values()) {
+            resetCounts.put(cause, new LongAdder());
+        }
+        this.snapshot = BridgeSnapshot.initial(keyType, ticker.nanoTime());
+    }
+
+    /**
+     * Накопленное значение ключа. До первого успешного наблюдения возвращает {@code 0} —
+     * локальный аккумулятор ещё не инициализирован, недоступность видна через отдельные
+     * {@code registered}/{@code readable}/{@code owner.present} гейджи, а не через это значение.
+     */
+    double count(K key) {
+        return refreshed().accumulated().getOrDefault(key, 0L).doubleValue();
+    }
+
+    /** Число ресетов накопленного состояния по конкретной причине, для {@code source_resets_total}. */
+    long resetCount(ResetCause cause) {
+        return resetCounts.get(cause).sum();
+    }
+
+    /** Число обратных аномалий конкретного cumulative-ключа, для {@code backward_value_anomalies_total}. */
+    long anomalyCount(K key) {
+        return anomalyCounts.get(key).sum();
+    }
+
+    private BridgeSnapshot<K> refreshed() {
+        BridgeSnapshot<K> current = snapshot;
+        if (isFresh(current)) {
+            return current;
+        }
+        if (refreshLock.tryLock()) {
+            try {
+                current = doRefresh(snapshot);
+                snapshot = current;
+            } finally {
+                refreshLock.unlock();
+            }
+        }
+        return current;
+    }
+
+    private boolean isFresh(BridgeSnapshot<K> current) {
+        return current.lastGeneration() != NEVER_OBSERVED_GENERATION
+                && (ticker.nanoTime() - current.refreshedAtNanos()) < coalescingWindowNanos;
+    }
+
+    private BridgeSnapshot<K> doRefresh(BridgeSnapshot<K> previous) {
+        long now = ticker.nanoTime();
+        Optional<JmxOwnerState<Map<K, Long>>> observed = source.get();
+        if (observed.isEmpty() || !(observed.get() instanceof JmxOwnerState.Present<Map<K, Long>> present)) {
+            // Недоступное чтение (Absent MBean, ContractViolation, ExecutionFailure) или отсутствующий
+            // владелец не меняет накопленное — обновляется только момент попытки, чтобы coalescing-окно
+            // продолжало объединять вызовы одного scrape.
+            return previous.withRefreshedAt(now);
+        }
+
+        Map<K, Long> raw = present.values();
+        long generation = present.generation();
+        String currentAgentInstanceId = agentInstanceId.get();
+        boolean neverObserved = previous.lastGeneration() == NEVER_OBSERVED_GENERATION;
+        boolean agentInstanceChanged = !neverObserved && !currentAgentInstanceId.equals(previous.lastAgentInstanceId());
+        boolean ownerReplaced = !neverObserved && !agentInstanceChanged && previous.lastGeneration() != generation;
+        if (agentInstanceChanged) {
+            resetCounts.get(ResetCause.AGENT_INSTANCE_CHANGED).increment();
+        } else if (ownerReplaced) {
+            resetCounts.get(ResetCause.OWNER_REPLACED).increment();
+        }
+        boolean identityReset = neverObserved || agentInstanceChanged || ownerReplaced;
+
+        EnumMap<K, Long> accumulated = new EnumMap<>(previous.accumulated());
+        EnumMap<K, Long> lastRaw = new EnumMap<>(keyType);
+        for (K key : keyType.getEnumConstants()) {
+            long currentRaw = raw.getOrDefault(key, 0L);
+            lastRaw.put(key, currentRaw);
+            if (identityReset) {
+                // Новая identity: каждый cumulative-ключ добавляет свой первый raw как приращение
+                // к историческому итогу — накопленное значение никогда не убывает даже при замене владельца.
+                accumulated.merge(key, currentRaw, Long::sum);
+                continue;
+            }
+            long previousRaw = previous.lastRaw().getOrDefault(key, 0L);
+            long delta = currentRaw - previousRaw;
+            if (delta < 0) {
+                anomalyCounts.get(key).increment();
+                // Аномалия фиксируется для этого ключа; остальные ключи продолжают обновляться корректно,
+                // накопленное значение этого ключа не меняется в цикле аномального наблюдения.
+            } else if (delta > 0) {
+                accumulated.merge(key, delta, Long::sum);
+            }
+        }
+        return new BridgeSnapshot<>(accumulated, lastRaw, currentAgentInstanceId, generation, now);
+    }
+
+    private record BridgeSnapshot<K extends Enum<K>>(
+            EnumMap<K, Long> accumulated,
+            EnumMap<K, Long> lastRaw,
+            String lastAgentInstanceId,
+            long lastGeneration,
+            long refreshedAtNanos) {
+
+        static <K extends Enum<K>> BridgeSnapshot<K> initial(Class<K> keyType, long now) {
+            return new BridgeSnapshot<>(new EnumMap<>(keyType), new EnumMap<>(keyType), null, NEVER_OBSERVED_GENERATION, now);
+        }
+
+        BridgeSnapshot<K> withRefreshedAt(long now) {
+            return new BridgeSnapshot<>(accumulated, lastRaw, lastAgentInstanceId, lastGeneration, now);
+        }
+    }
+}
