@@ -0,0 +1,21 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+import java.time.Instant;
+
+/**
+ * Текущее состояние одной точки контракта. Поле называется {@code unrecoveredHint}, а не
+ * {@code active}: JMX читается по запросу, поэтому «после последнего зафиксированного отказа
+ * успешного чтения не наблюдалось» — не утверждение о непрерывной доступности. Настоящее
+ * {@code unrecovered} вычисляется на уровне diagnostic-записи ({@code failureSequence} против
+ * {@code lastSuccessSequence}), это состояние хранит только сырые данные для такого вычисления.
+ */
+public record JmxPointReadState(
+        long lastAppliedSequence,
+        long lastSuccessSequence,
+        Instant lastAttemptAt,
+        Instant lastSuccessAt,
+        JmxLastReadOutcome lastOutcome) {
+
+    public static final JmxPointReadState NEVER_READ =
+            new JmxPointReadState(-1L, -1L, null, null, JmxLastReadOutcome.NEVER_READ);
+}
diff --git a/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxReadExecutor.java b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxReadExecutor.java
new file mode 100644
index 00000000..7171d446
--- /dev/null
+++ b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxReadExecutor.java
@@ -0,0 +1,272 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+import javax.management.AttributeNotFoundException;
+import javax.management.InstanceNotFoundException;
+import javax.management.MBeanException;
+import javax.management.MBeanServerConnection;
+import javax.management.ObjectName;
+import javax.management.ReflectionException;
+import javax.management.RuntimeErrorException;
+import javax.management.RuntimeMBeanException;
+import javax.management.RuntimeOperationsException;
+import java.io.IOException;
+import java.time.Clock;
+import java.time.Duration;
+import java.time.Instant;
+import java.util.EnumMap;
+import java.util.List;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.locks.ReentrantLock;
+
+/**
+ * Единственная точка доступа к {@code MBeanServerConnection}. Внутренний порт типизирован
+ * как {@code MBeanServerConnection}, а не {@code MBeanServer}: иначе {@code IOException} в
+ * таксономии недостижим. {@code MBeanServer} расширяет {@code MBeanServerConnection}, поэтому
+ * {@code ManagementFactory.getPlatformMBeanServer()} передаётся без изменений.
+ *
+ * <p>{@code JmxRead} — четырёхсоставная модель исхода — и классификация исключений
+ * являются {@code private nested}: доменная проекция не может сматчить {@code Present}
+ * и потерять нарушение, потому что не может назвать тип. Публичной перегрузки
+ * {@code read(ObjectName, String, Class)} не существует, поэтому строковый литерал
+ * атрибута инкапсулирован в {@link JmxAttribute} и не попадает в фасад или потребителя.
+ *
+ * <p>Пара «transport-вызов → назначение {@code observationSequence}» сериализуется
+ * per-{@link JmxDomain} захватом {@link ReentrantLock}: полная локальная линеаризация
+ * на стороне приложения этим достижима, а export hot path агента не затрагивается —
+ * лок держит только эти шесть диагностических MBean. Лок удерживается исключительно на
+ * transport-вызове и взятии номера; декодирование и семантическая валидация выполняются
+ * вне лока, поэтому медленный decode не влияет на порядок, а вызовы разных доменов друг
+ * друга не блокируют.
+ */
+public final class JmxReadExecutor {
+
+    private static final Duration DEFAULT_WARN_RATE_LIMIT = Duration.ofMinutes(5);
+
+    private final MBeanServerConnection connection;
+    private final Clock clock;
+    private final JmxReadStateRegistry registry;
+    private final EnumMap<JmxDomain, ReentrantLock> transportLocks = new EnumMap<>(JmxDomain.class);
+    private final AtomicLong observationSequence = new AtomicLong();
+
+    public JmxReadExecutor(MBeanServerConnection connection) {
+        this(connection, Clock.systemUTC(), DEFAULT_WARN_RATE_LIMIT);
+    }
+
+    public JmxReadExecutor(MBeanServerConnection connection, Clock clock, Duration warnRateLimit) {
+        this.connection = Objects.requireNonNull(connection, "connection");
+        this.clock = Objects.requireNonNull(clock, "clock");
+        this.registry = new JmxReadStateRegistry(clock, warnRateLimit);
+        for (JmxDomain domain : JmxDomain.values()) {
+            transportLocks.put(domain, new ReentrantLock());
+        }
+    }
+
+    /** Только для доменных проекций и {@code tracingStatus} — не публикуется наружу пакета. */
+    JmxReadStateRegistry registry() {
+        return registry;
+    }
+
+    /** Снимок для {@code tracingStatus.jmxContractDiagnostics} — см. {@link JmxReadStateRegistry#diagnosticSnapshot()}. */
+    public List<JmxDiagnosticSnapshot> diagnosticSnapshot() {
+        return registry.diagnosticSnapshot();
+    }
+
+    /** Freshness точки контракта; {@code empty} до первого успеха. */
+    public Optional<Duration> lastSuccessAge(JmxContractPoint point) {
+        return registry.lastSuccessAge(point);
+    }
+
+    public <T> Optional<T> read(ObjectName objectName, JmxAttribute<T> attribute) {
+        TimedRead<Object> raw = readRaw(attribute.point(), () -> connection.getAttribute(objectName, attribute.name()));
+        return resolve(attribute.point(), attribute.decoder(), raw);
+    }
+
+    public <T> Optional<T> invoke(ObjectName objectName, JmxOperation<T> operation, Object... arguments) {
+        String[] signature = validateAndBuildSignature(operation, arguments);
+        Object[] encoded = encodeArguments(operation, arguments);
+        TimedRead<Object> raw = readRaw(operation.point(),
+                () -> connection.invoke(objectName, operation.name(), encoded, signature));
+        return resolve(operation.point(), operation.decoder(), raw);
+    }
+
+    public JmxMBeanRegistrationState registration(ObjectName objectName, JmxContractPoint point) {
+        ReentrantLock lock = transportLocks.get(point.domain());
+        lock.lock();
+        try {
+            boolean registered;
+            long sequence;
+            Instant observedAt;
+            try {
+                registered = connection.isRegistered(objectName);
+                sequence = observationSequence.incrementAndGet();
+                observedAt = clock.instant();
+            } catch (IOException e) {
+                sequence = observationSequence.incrementAndGet();
+                observedAt = clock.instant();
+                registry.recordExecutionFailure(point, JmxDiagnosticKind.CONNECTOR_FAILURE, sequence, observedAt);
+                return JmxMBeanRegistrationState.UNKNOWN;
+            } catch (SecurityException e) {
+                sequence = observationSequence.incrementAndGet();
+                observedAt = clock.instant();
+                registry.recordExecutionFailure(point, JmxDiagnosticKind.SECURITY_FAILURE, sequence, observedAt);
+                return JmxMBeanRegistrationState.UNKNOWN;
+            }
+            if (registered) {
+                registry.recordPresent(point, sequence, observedAt);
+                return JmxMBeanRegistrationState.REGISTERED;
+            }
+            registry.recordAbsent(point, sequence, observedAt);
+            return JmxMBeanRegistrationState.NOT_REGISTERED;
+        } finally {
+            lock.unlock();
+        }
+    }
+
+    // -- Резолюция: decode вне лока, единственный проекционный переход в Optional<T> -----
+
+    private <T> Optional<T> resolve(JmxContractPoint point, JmxValueDecoder<T> decoder, TimedRead<Object> raw) {
+        return switch (raw.read()) {
+            case JmxRead.Present<Object> present -> resolvePresent(point, decoder, raw.sequence(), raw.observedAt(), present.value());
+            case JmxRead.Absent<Object> ignored -> {
+                registry.recordAbsent(point, raw.sequence(), raw.observedAt());
+                yield Optional.empty();
+            }
+            case JmxRead.ContractViolation<Object> violation -> {
+                registry.recordContractViolation(point, violation.kind(), raw.sequence(), raw.observedAt());
+                yield Optional.empty();
+            }
+            case JmxRead.ExecutionFailure<Object> failure -> {
+                registry.recordExecutionFailure(point, failure.kind(), raw.sequence(), raw.observedAt());
+                yield Optional.empty();
+            }
+        };
+    }
+
+    private <T> Optional<T> resolvePresent(
+            JmxContractPoint point, JmxValueDecoder<T> decoder, long sequence, Instant observedAt, Object rawValue) {
+        if (rawValue == null) {
+            registry.recordContractViolation(point, JmxDiagnosticKind.NULL_VALUE_FOR_REQUIRED_MEMBER, sequence, observedAt);
+            return Optional.empty();
+        }
+        try {
+            T decoded = decoder.decode(rawValue);
+            registry.recordPresent(point, sequence, observedAt);
+            return Optional.of(decoded);
+        } catch (JmxContractViolationException e) {
+            registry.recordContractViolation(point, e.kind(), sequence, observedAt);
+            return Optional.empty();
+        }
+    }
+
+    // -- Transport + классификация, сериализованные per-domain ------------------------------
+
+    private TimedRead<Object> readRaw(JmxContractPoint point, TransportCall call) {
+        ReentrantLock lock = transportLocks.get(point.domain());
+        lock.lock();
+        try {
+            try {
+                Object value = call.execute();
+                return new TimedRead<>(observationSequence.incrementAndGet(), clock.instant(), new JmxRead.Present<>(value));
+            } catch (InstanceNotFoundException e) {
+                return new TimedRead<>(observationSequence.incrementAndGet(), clock.instant(), new JmxRead.Absent<>());
+            } catch (AttributeNotFoundException e) {
+                return contractViolation(JmxDiagnosticKind.MISSING_ATTRIBUTE);
+            } catch (ReflectionException e) {
+                Throwable cause = e.getCause();
+                if (cause instanceof NoSuchMethodException || cause instanceof ClassNotFoundException) {
+                    return contractViolation(JmxDiagnosticKind.OPERATION_SIGNATURE_DRIFT);
+                }
+                return executionFailure(JmxDiagnosticKind.REFLECTION_UNCLASSIFIED);
+            } catch (MBeanException e) {
+                return executionFailure(JmxDiagnosticKind.MBEAN_EXECUTION_FAILURE);
+            } catch (RuntimeMBeanException e) {
+                return executionFailure(JmxDiagnosticKind.MBEAN_EXECUTION_FAILURE);
+            } catch (RuntimeErrorException e) {
+                return executionFailure(JmxDiagnosticKind.MBEAN_RUNTIME_ERROR);
+            } catch (RuntimeOperationsException e) {
+                if (e.getCause() instanceof IllegalArgumentException) {
+                    // Дефект локального вызова (арность/типы аргументов) — не диагностика сервера.
+                    throw new IllegalArgumentException("Локально некорректный вызов JMX-операции для " + point, e);
+                }
+                return executionFailure(JmxDiagnosticKind.OPERATIONS_EXCEPTION_UNCLASSIFIED);
+            } catch (SecurityException e) {
+                return executionFailure(JmxDiagnosticKind.SECURITY_FAILURE);
+            } catch (IOException e) {
+                return executionFailure(JmxDiagnosticKind.CONNECTOR_FAILURE);
+            }
+        } finally {
+            lock.unlock();
+        }
+    }
+
+    private TimedRead<Object> contractViolation(JmxDiagnosticKind kind) {
+        return new TimedRead<>(observationSequence.incrementAndGet(), clock.instant(), new JmxRead.ContractViolation<>(kind));
+    }
+
+    private TimedRead<Object> executionFailure(JmxDiagnosticKind kind) {
+        return new TimedRead<>(observationSequence.incrementAndGet(), clock.instant(), new JmxRead.ExecutionFailure<>(kind));
+    }
+
+    // -- Локальная валидация вызова операции, до любого transport-вызова --------------------
+
+    private static String[] validateAndBuildSignature(JmxOperation<?> operation, Object[] arguments) {
+        List<JmxParameter<?>> parameters = operation.parameters();
+        if (arguments.length != parameters.size()) {
+            throw new IllegalArgumentException("Неверная арность вызова " + operation.name()
+                    + ": ожидалось " + parameters.size() + ", передано " + arguments.length);
+        }
+        String[] signature = new String[parameters.size()];
+        for (int i = 0; i < parameters.size(); i++) {
+            JmxParameter<?> parameter = parameters.get(i);
+            Object argument = arguments[i];
+            if (argument != null && !parameter.type().isInstance(argument)) {
+                throw new IllegalArgumentException("Неверный тип аргумента #" + i + " вызова " + operation.name()
+                        + ": ожидался " + parameter.type().getName());
+            }
+            signature[i] = parameter.type().getName();
+        }
+        return signature;
+    }
+
+    private static Object[] encodeArguments(JmxOperation<?> operation, Object[] arguments) {
+        List<JmxParameter<?>> parameters = operation.parameters();
+        Object[] encoded = new Object[arguments.length];
+        for (int i = 0; i < arguments.length; i++) {
+            encoded[i] = encodeArgument(parameters.get(i), arguments[i]);
+        }
+        return encoded;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static <T> Object encodeArgument(JmxParameter<T> parameter, Object argument) {
+        return parameter.encoder().encode((T) argument);
+    }
+
+    @FunctionalInterface
+    private interface TransportCall {
+        Object execute() throws InstanceNotFoundException, AttributeNotFoundException, MBeanException,
+                ReflectionException, IOException;
+    }
+
+    /** Четыре исхода transport-наблюдения. Private nested — недостижим вне executor'а. */
+    private sealed interface JmxRead<T> {
+
+        record Present<T>(T value) implements JmxRead<T> {
+        }
+
+        record Absent<T>() implements JmxRead<T> {
+        }
+
+        record ContractViolation<T>(JmxDiagnosticKind kind) implements JmxRead<T> {
+        }
+
+        record ExecutionFailure<T>(JmxDiagnosticKind kind) implements JmxRead<T> {
+        }
+    }
+
+    /** Исход, привязанный к моменту его фактического наблюдения — авторитетная шкала упорядочения. */
+    private record TimedRead<T>(long sequence, Instant observedAt, JmxRead<T> read) {
+    }
+}
diff --git a/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxReadStateRegistry.java b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxReadStateRegistry.java
new file mode 100644
index 00000000..7d9fd8f5
--- /dev/null
+++ b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxReadStateRegistry.java
@@ -0,0 +1,158 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+import lombok.extern.slf4j.Slf4j;
+
+import java.time.Clock;
+import java.time.Duration;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.LongAdder;
+
+/**
+ * Read-state registry с сериализованным transport-порядком (см. {@link JmxReadExecutor}).
+ *
+ * <p>Правило разделено на два уровня: lifetime-счётчики увеличиваются для каждого реально
+ * произошедшего отказа независимо от порядка доставки в registry — история не теряется;
+ * текущее состояние ({@code unrecovered}, {@code lastOutcome}) обновляется только при
+ * {@code sequence >= lastAppliedSequence}, атомарной заменой всего {@link JmxPointReadState}
+ * внутри {@code ConcurrentHashMap#compute}, единым правилом для всех четырёх исходов.
+ *
+ * <p>WARN — один раз на unrecovered-эпизод diagnostic key, а не на point и не «один раз
+ * навсегда»; при флаппинге приоритет у rate limit — подавленный WARN учитывается отдельным
+ * счётчиком и остаётся видимым через {@code unrecovered} и lifetime-счётчики. Перевзводит
+ * WARN только success, принятый как текущее состояние: {@code recordPresent} сверяется с
+ * {@code lastSuccessSequence} той же точки, которую видит {@code recordDiagnostic} для этого
+ * же ключа, поэтому stale-success, отклонённый по {@code sequence}, эпизод не закрывает.
+ */
+@Slf4j
+final class JmxReadStateRegistry {
+
+    private final Clock clock;
+    private final long warnRateLimitMillis;
+
+    private final ConcurrentHashMap<JmxContractPoint, JmxPointReadState> pointStates = new ConcurrentHashMap<>();
+    private final ConcurrentHashMap<JmxDiagnosticKey, LongAdder> lifetimeCounts = new ConcurrentHashMap<>();
+    private final ConcurrentHashMap<JmxDiagnosticKey, LongAdder> suppressedWarnCounts = new ConcurrentHashMap<>();
+    private final ConcurrentHashMap<JmxDiagnosticKey, DiagnosticEpisode> episodes = new ConcurrentHashMap<>();
+    private final ConcurrentHashMap<JmxDiagnosticKey, AtomicLong> lastWarnEpochMillis = new ConcurrentHashMap<>();
+
+    JmxReadStateRegistry(Clock clock, Duration warnRateLimit) {
+        this.clock = Objects.requireNonNull(clock, "clock");
+        this.warnRateLimitMillis = Objects.requireNonNull(warnRateLimit, "warnRateLimit").toMillis();
+    }
+
+    void recordPresent(JmxContractPoint point, long sequence, Instant observedAt) {
+        applyPointState(point, sequence, observedAt, JmxLastReadOutcome.PRESENT, true);
+    }
+
+    void recordAbsent(JmxContractPoint point, long sequence, Instant observedAt) {
+        applyPointState(point, sequence, observedAt, JmxLastReadOutcome.ABSENT, false);
+    }
+
+    void recordContractViolation(JmxContractPoint point, JmxDiagnosticKind kind, long sequence, Instant observedAt) {
+        recordDiagnostic(point, JmxDiagnosticCategory.CONTRACT_VIOLATION, kind, sequence, observedAt);
+        applyPointState(point, sequence, observedAt, JmxLastReadOutcome.CONTRACT_VIOLATION, false);
+    }
+
+    void recordExecutionFailure(JmxContractPoint point, JmxDiagnosticKind kind, long sequence, Instant observedAt) {
+        recordDiagnostic(point, JmxDiagnosticCategory.EXECUTION_FAILURE, kind, sequence, observedAt);
+        applyPointState(point, sequence, observedAt, JmxLastReadOutcome.EXECUTION_FAILURE, false);
+    }
+
+    JmxPointReadState pointState(JmxContractPoint point) {
+        return pointStates.getOrDefault(point, JmxPointReadState.NEVER_READ);
+    }
+
+    /** Freshness: пусто до первого успеха — проекция в {@code NaN} выполняется на уровне Micrometer-биндера. */
+    Optional<Duration> lastSuccessAge(JmxContractPoint point) {
+        Instant lastSuccessAt = pointState(point).lastSuccessAt();
+        return lastSuccessAt == null ? Optional.empty() : Optional.of(Duration.between(lastSuccessAt, clock.instant()));
+    }
+
+    /** Снимок для {@code tracingStatus.jmxContractDiagnostics}, детерминированно отсортированный. */
+    List<JmxDiagnosticSnapshot> diagnosticSnapshot() {
+        List<JmxDiagnosticSnapshot> snapshots = new ArrayList<>();
+        for (var entry : episodes.entrySet()) {
+            JmxDiagnosticKey key = entry.getKey();
+            DiagnosticEpisode episode = entry.getValue();
+            long lastSuccessSequence = pointState(key.point()).lastSuccessSequence();
+            long lifetimeCount = lifetimeCounts.getOrDefault(key, EMPTY_ADDER).sum();
+            long suppressedCount = suppressedWarnCounts.getOrDefault(key, EMPTY_ADDER).sum();
+            boolean unrecovered = episode.failureSequence() > lastSuccessSequence;
+            snapshots.add(new JmxDiagnosticSnapshot(key.point(), key.category(), key.kind(), lifetimeCount,
+                    suppressedCount, episode.firstSeenAt(), episode.lastSeenAt(),
+                    pointState(key.point()).lastAttemptAt(), unrecovered));
+        }
+        snapshots.sort(Comparator
+                .comparing(JmxDiagnosticSnapshot::point)
+                .thenComparing(JmxDiagnosticSnapshot::category)
+                .thenComparing(JmxDiagnosticSnapshot::kind));
+        return List.copyOf(snapshots);
+    }
+
+    private static final LongAdder EMPTY_ADDER = new LongAdder();
+
+    // -- Текущее состояние точки: единая шкала observationSequence для всех исходов --------
+
+    private void applyPointState(
+            JmxContractPoint point, long sequence, Instant observedAt, JmxLastReadOutcome outcome, boolean success) {
+        pointStates.compute(point, (ignoredPoint, previous) -> {
+            if (previous != null && sequence < previous.lastAppliedSequence()) {
+                return previous; // устаревшая доставка — текущее состояние не меняем
+            }
+            Instant lastSuccessAt = success ? observedAt : (previous == null ? null : previous.lastSuccessAt());
+            long lastSuccessSequence = success ? sequence : (previous == null ? -1L : previous.lastSuccessSequence());
+            return new JmxPointReadState(sequence, lastSuccessSequence, observedAt, lastSuccessAt, outcome);
+        });
+    }
+
+    // -- Lifetime-счётчики и unrecovered-эпизоды, независимо от порядка доставки -----------
+
+    private void recordDiagnostic(
+            JmxContractPoint point, JmxDiagnosticCategory category, JmxDiagnosticKind kind,
+            long sequence, Instant observedAt) {
+        JmxDiagnosticKey key = new JmxDiagnosticKey(point, category, kind);
+        lifetimeCounts.computeIfAbsent(key, ignored -> new LongAdder()).increment();
+
+        boolean[] episodeOpened = new boolean[1];
+        episodes.compute(key, (ignoredKey, previous) -> {
+            long lastSuccessSequence = pointState(point).lastSuccessSequence();
+            boolean wasRecovered = previous == null || previous.failureSequence() <= lastSuccessSequence;
+            episodeOpened[0] = wasRecovered;
+            Instant firstSeenAt = previous == null ? observedAt : previous.firstSeenAt();
+            long failureSequence = previous == null ? sequence : Math.max(sequence, previous.failureSequence());
+            return new DiagnosticEpisode(failureSequence, firstSeenAt, observedAt);
+        });
+
+        if (episodeOpened[0]) {
+            warnOncePerEpisodeRateLimited(key, observedAt);
+        }
+    }
+
+    private void warnOncePerEpisodeRateLimited(JmxDiagnosticKey key, Instant observedAt) {
+        AtomicLong lastWarn = lastWarnEpochMillis.computeIfAbsent(key, ignored -> new AtomicLong(Long.MIN_VALUE));
+        long now = observedAt.toEpochMilli();
+        long previousWarn = lastWarn.get();
+        if (now - previousWarn < warnRateLimitMillis) {
+            suppressedWarnCounts.computeIfAbsent(key, ignored -> new LongAdder()).increment();
+            return;
+        }
+        if (lastWarn.compareAndSet(previousWarn, now)) {
+            log.warn("JMX-контракт: {} {} на точке {} (первое или повторное после recovery)",
+                    key.category(), key.kind(), key.point());
+        } else {
+            // Проиграли гонку конкурентного открытия эпизода — уже предупредили.
+            suppressedWarnCounts.computeIfAbsent(key, ignored -> new LongAdder()).increment();
+        }
+    }
+
+    /** Момент возникновения текущего непрерывного unrecovered-эпизода этого diagnostic key. */
+    private record DiagnosticEpisode(long failureSequence, Instant firstSeenAt, Instant lastSeenAt) {
+    }
+}
diff --git a/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxValueDecoder.java b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxValueDecoder.java
new file mode 100644
