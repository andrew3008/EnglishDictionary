+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * Дескриптор JMX-операции с типизированной схемой параметров.
+ *
+ * @param <T> доменный тип результата после декодирования
+ */
+public record JmxOperation<T>(
+        String name,
+        List<JmxParameter<?>> parameters,
+        JmxContractPoint point,
+        JmxValueDecoder<T> decoder) implements JmxMember<T> {
+
+    public JmxOperation {
+        Objects.requireNonNull(name, "name");
+        parameters = List.copyOf(Objects.requireNonNull(parameters, "parameters"));
+        Objects.requireNonNull(point, "point");
+        Objects.requireNonNull(decoder, "decoder");
+    }
+}
