@@ -0,0 +1,58 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.observation;
+
+import org.junit.jupiter.api.Test;
+
+import java.io.BufferedReader;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Independent verification: значения {@link JmxObservationWireContract} на стороне
+ * autoconfigure сверяются с committed golden-resource, а не с agent-копией (общий Java-тип
+ * невозможен из-за classloader isolation; tautological parity двух classpath'ов запрещён).
+ * Зеркальный тест живёт в agent-модуле.
+ */
+class JmxObservationWireContractIndependentVerifyTest {
+
+    @Test
+    void schemaVersionAndFrameItemsMatchGoldenResource() throws Exception {
+        Map<String, String> expected = loadGolden();
+        assertThat(JmxObservationWireContract.SCHEMA_VERSION)
+                .isEqualTo(Integer.parseInt(expected.get("SCHEMA_VERSION")));
+        assertThat(JmxObservationWireContract.ITEM_SCHEMA_VERSION).isEqualTo(expected.get("ITEM_SCHEMA_VERSION"));
+        assertThat(JmxObservationWireContract.ITEM_CAPTURE_SEQUENCE).isEqualTo(expected.get("ITEM_CAPTURE_SEQUENCE"));
+        assertThat(JmxObservationWireContract.ITEM_AGENT_INSTANCE_ID).isEqualTo(expected.get("ITEM_AGENT_INSTANCE_ID"));
+        assertThat(JmxObservationWireContract.ITEM_OWNER_PRESENT).isEqualTo(expected.get("ITEM_OWNER_PRESENT"));
+        assertThat(JmxObservationWireContract.ITEM_OWNER_GENERATION).isEqualTo(expected.get("ITEM_OWNER_GENERATION"));
+        assertThat(JmxObservationWireContract.SAMPLING_ITEM_SAMPLER_OWNER_PRESENT)
+                .isEqualTo(expected.get("SAMPLING_ITEM_SAMPLER_OWNER_PRESENT"));
+        assertThat(JmxObservationWireContract.EXPORT_ITEM_PROCESSOR).isEqualTo(expected.get("EXPORT_ITEM_PROCESSOR"));
+        assertThat(JmxObservationWireContract.PROCESSOR_METRICS_ITEM_WATCHDOG)
+                .isEqualTo(expected.get("PROCESSOR_METRICS_ITEM_WATCHDOG"));
+    }
+
+    private static Map<String, String> loadGolden() throws Exception {
+        String resource = "jmx-observation-wire-contract-golden.properties";
+        InputStream stream = JmxObservationWireContractIndependentVerifyTest.class
+                .getClassLoader()
+                .getResourceAsStream(resource);
+        assertThat(stream).as(resource).isNotNull();
+        Map<String, String> values = new LinkedHashMap<>();
+        try (BufferedReader reader = new BufferedReader(new InputStreamReader(stream, StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                if (line.isBlank() || line.startsWith("#")) {
+                    continue;
+                }
+                int eq = line.indexOf('=');
+                values.put(line.substring(0, eq), line.substring(eq + 1));
+            }
+        }
+        return values;
+    }
+}
