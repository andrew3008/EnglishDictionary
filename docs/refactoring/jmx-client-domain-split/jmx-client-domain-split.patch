@@ -0,0 +1,18 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+/**
+ * Tri-state результат проверки регистрации MBean. {@code boolean} недостаточен:
+ * он не выражает отказ самой проверки ({@code SecurityException}, отказ транспорта),
+ * который иначе либо вылетит в Actuator, либо неотличимо схлопнется в {@code false}.
+ */
+public enum JmxMBeanRegistrationState {
+
+    /** MBean зарегистрирован на момент проверки. */
+    REGISTERED,
+
+    /** MBean не зарегистрирован — штатное состояние, WARN не пишется. */
+    NOT_REGISTERED,
+
+    /** Сама проверка регистрации завершилась отказом транспорта; состояние неизвестно. */
+    UNKNOWN
+}
