--- /dev/null
+++ b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxContractViolation.java
@@ -0,0 +1,23 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+import java.util.Objects;
+
+/**
+ * Нарушение wire-контракта: сервер ответил, но ответ не соответствует нормативной
+ * схеме (неверный тип, отсутствующий член, нарушение семантического валидатора).
+ * Отличается от {@link JmxExecutionFailure}, который описывает отказ самой
+ * MBean-реализации или транспорта.
+ */
+public record JmxContractViolation(
+        JmxContractPoint point,
+        JmxDiagnosticKind kind,
+        JmxWireTypeCode expectedType,
+        JmxWireTypeCode actualType) {
+
+    public JmxContractViolation {
+        Objects.requireNonNull(point, "point");
+        Objects.requireNonNull(kind, "kind");
+        Objects.requireNonNull(expectedType, "expectedType");
+        Objects.requireNonNull(actualType, "actualType");
+    }
+}
diff --git a/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxContractViolationException.java b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxContractViolationException.java
new file mode 100644
index 00000000..837e4cf2
--- /dev/null
+++ b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxContractViolationException.java
@@ -0,0 +1,33 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+/**
+ * Единственный сигнальный механизм {@link JmxValueDecoder}: синтаксически полученный
+ * ответ не соответствует нормативной схеме. {@code JmxReadExecutor} перехватывает его
+ * в момент декодирования и превращает в {@code JmxRead.ContractViolation} — наружу,
+ * за пределы executor'а, оно никогда не пробрасывается как исключение.
+ */
+public final class JmxContractViolationException extends RuntimeException {
+
+    private final JmxDiagnosticKind kind;
+    private final JmxWireTypeCode expectedType;
+    private final JmxWireTypeCode actualType;
+
+    public JmxContractViolationException(JmxDiagnosticKind kind, JmxWireTypeCode expectedType, JmxWireTypeCode actualType) {
+        super(kind + ": expected=" + expectedType + ", actual=" + actualType, null, false, false);
+        this.kind = kind;
+        this.expectedType = expectedType;
+        this.actualType = actualType;
+    }
+
+    public JmxDiagnosticKind kind() {
+        return kind;
+    }
+
+    public JmxWireTypeCode expectedType() {
+        return expectedType;
+    }
+
+    public JmxWireTypeCode actualType() {
+        return actualType;
+    }
+}
