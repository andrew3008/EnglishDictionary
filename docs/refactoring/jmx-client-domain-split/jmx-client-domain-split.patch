--- /dev/null
+++ b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxAttribute.java
@@ -0,0 +1,21 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+import java.util.Objects;
+
+/**
+ * Дескриптор JMX-атрибута. Единственный способ прочитать атрибут через
+ * {@link JmxReadExecutor} — публичной перегрузки {@code read(ObjectName, String, Class)}
+ * не существует, поэтому строковый литерал имени атрибута инкапсулирован здесь и не
+ * может попасть в фасад или доменную проекцию напрямую.
+ *
+ * @param <T> доменный тип после декодирования
+ */
+public record JmxAttribute<T>(String name, JmxContractPoint point, JmxValueDecoder<T> decoder)
+        implements JmxMember<T> {
+
+    public JmxAttribute {
+        Objects.requireNonNull(name, "name");
+        Objects.requireNonNull(point, "point");
+        Objects.requireNonNull(decoder, "decoder");
+    }
+}
diff --git a/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxContractPoint.java b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxContractPoint.java
new file mode 100644
index 00000000..641f6759
--- /dev/null
+++ b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxContractPoint.java
@@ -0,0 +1,37 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+/**
+ * Закрытое перечисление точек JMX-контракта: по одной точке наблюдения и одной
+ * точке проверки регистрации на домен. Строка сервера или имя Java-класса не
+ * может стать точкой контракта — только эти двенадцать значений.
+ */
+public enum JmxContractPoint {
+
+    SAMPLING_OBSERVATION(JmxDomain.SAMPLING),
+    SAMPLING_REGISTRATION(JmxDomain.SAMPLING),
+
+    SCRUBBING_OBSERVATION(JmxDomain.SCRUBBING),
+    SCRUBBING_REGISTRATION(JmxDomain.SCRUBBING),
+
+    VALIDATION_OBSERVATION(JmxDomain.VALIDATION),
+    VALIDATION_REGISTRATION(JmxDomain.VALIDATION),
+
+    EXPORT_OBSERVATION(JmxDomain.EXPORT),
+    EXPORT_REGISTRATION(JmxDomain.EXPORT),
+
+    PROCESSOR_METRICS_OBSERVATION(JmxDomain.PROCESSOR_METRICS),
+    PROCESSOR_METRICS_REGISTRATION(JmxDomain.PROCESSOR_METRICS),
+
+    DIAGNOSTICS_OBSERVATION(JmxDomain.DIAGNOSTICS),
+    DIAGNOSTICS_REGISTRATION(JmxDomain.DIAGNOSTICS);
+
+    private final JmxDomain domain;
+
+    JmxContractPoint(JmxDomain domain) {
+        this.domain = domain;
+    }
+
+    public JmxDomain domain() {
+        return domain;
+    }
+}
diff --git a/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxContractViolation.java b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxContractViolation.java
