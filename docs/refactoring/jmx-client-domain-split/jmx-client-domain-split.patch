+    DROPPED_FALLBACK_DROP("DROP", PlatformSamplingReasons.FALLBACK_DROP);
+
+    private final String decision;
+    private final String reason;
+
+    SamplerDecisionKey(String decision, String reason) {
+        this.decision = decision;
+        this.reason = reason;
+    }
+
+    String decision() {
+        return decision;
+    }
+
+    String reason() {
