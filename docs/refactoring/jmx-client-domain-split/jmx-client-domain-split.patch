+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx;
+
+import java.util.Map;
+
+/**
+ * Декодированное {@code SamplingObservation}. {@code samplerEnabled}/{@code samplingRatio}/
+ * {@code routeRatios} происходят из всегда-присутствующего {@code AcceptedPolicyAccess} —
+ * presence для них не нужен. {@code decisionCounts} принадлежит заменяемому {@code CompositeSampler}
+ * и поэтому presence-дискриминирован отдельно.
+ */
+public record SamplingObservation(
+        boolean samplerEnabled,
+        double samplingRatio,
+        int liveRouteRatioCount,
+        String configLastUpdatedSource,
+        JmxOwnerState<Map<String, Long>> decisionCounts) {
+}
