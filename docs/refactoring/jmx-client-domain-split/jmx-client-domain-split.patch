+package space.br1440.platform.tracing.autoconfigure.metrics;
+
+import space.br1440.platform.tracing.api.attributes.PlatformSamplingReasons;
+
+/**
+ * Закрытое enum-пространство одиннадцати cumulative-ключей одного {@code CompositeSampler}-владельца
+ * (пять {@code RECORD_AND_SAMPLE}-причин, шесть {@code DROP}-причин), используемое
+ * {@link MonotonicJmxCounterGroupBridge} как единая группа для одного JMX-observation.
+ */
