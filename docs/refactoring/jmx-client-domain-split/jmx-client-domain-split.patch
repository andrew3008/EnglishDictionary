@@ -0,0 +1,17 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+/**
+ * Типизированный член JMX-контракта: атрибут или операция. {@code nullable} как
+ * свойство дескриптора отсутствует — он несовместим с {@code Optional<T>}
+ * ({@code Optional.of(null)} запрещён, {@code Optional.empty()} занят проекцией
+ * {@code Absent}). Любой {@code null} от сервера — это {@code ContractViolation}
+ * с кодом {@code NULL_VALUE_FOR_REQUIRED_MEMBER}, а не штатное отсутствие значения.
+ *
+ * @param <T> доменный тип после декодирования
+ */
+public sealed interface JmxMember<T> permits JmxAttribute, JmxOperation {
+
+    JmxContractPoint point();
+
+    JmxValueDecoder<T> decoder();
+}
