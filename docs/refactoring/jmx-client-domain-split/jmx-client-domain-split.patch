@@ -0,0 +1,39 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx;
+
+import java.util.Objects;
+
+/**
+ * Presence-состояние одного заменяемого владельца внутри доменного observation, зеркало
+ * агентского {@code OwnerRegistrationState} на стороне decode. Значения владельца при
+ * {@link Absent} не публикуются вовсе — placeholder агентской стороны сюда не попадает,
+ * поэтому потребитель физически не может интерпретировать его как telemetry.
+ *
+ * <p>{@code sealed} с ровно двумя permits — намеренно закрытый набор состояний, а не
+ * произвольный SPI: расширение набора состояний было бы breaking-изменением decode-контракта.
+ *
+ * @param <T> тип доменных значений владельца
+ */
+public sealed interface JmxOwnerState<T> permits JmxOwnerState.Present, JmxOwnerState.Absent {
+
+    /** Generation владельца: положительна при {@link Present}, {@code >= 0} при {@link Absent}. */
+    long generation();
+
+    record Present<T>(T values, long generation) implements JmxOwnerState<T> {
+
+        public Present {
+            Objects.requireNonNull(values, "values");
+            if (generation <= 0) {
+                throw new IllegalArgumentException("generation присутствующего владельца должна быть положительной: " + generation);
+            }
+        }
+    }
+
+    record Absent<T>(long generation) implements JmxOwnerState<T> {
+
+        public Absent {
+            if (generation < 0) {
+                throw new IllegalArgumentException("generation не может быть отрицательной: " + generation);
+            }
+        }
+    }
+}
