+++ b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxValueDecoder.java
@@ -0,0 +1,26 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+/**
+ * Декодирует и семантически валидирует сырое значение, полученное транспортом.
+ * {@code Class<T>} не выражает параметризованные типы вроде {@code Map<String, Long>}
+ * из-за стирания типов, поэтому декодер сам проверяет каждый ключ, значение и элемент
+ * и возвращает неизменяемую копию. Одна некорректная запись делает недействительным
+ * весь член: декодер обязан бросить {@link JmxContractViolationException}, а не
+ * пропустить повреждённую запись молча.
+ *
+ * <p>{@code null} для обязательного члена не проходит через декодер: executor
+ * проверяет {@code raw == null} до вызова {@link #decode(Object)} и формирует
+ * {@code ContractViolation(NULL_VALUE_FOR_REQUIRED_MEMBER)} самостоятельно.
+ *
+ * @param <T> доменный тип после декодирования
+ */
+@FunctionalInterface
+public interface JmxValueDecoder<T> {
+
+    /**
+     * @param raw ненулевое сырое значение, полученное от {@code MBeanServerConnection}
+     * @return декодированное и валидированное доменное значение
+     * @throws JmxContractViolationException если значение не соответствует нормативной схеме
+     */
+    T decode(Object raw);
+}
