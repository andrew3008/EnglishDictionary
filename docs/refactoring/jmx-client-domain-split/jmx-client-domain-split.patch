new file mode 100644
index 00000000..f5096a4e
--- /dev/null
+++ b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/observation/JmxObservationWireContract.java
@@ -0,0 +1,218 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.observation;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Slice 0: нормативный wire-контракт шести domain-level JMX observation-членов —
+ * копия декодера, независимая от агентской стороны.
+ *
+ * <p>Общий Java-тип с {@code platform-tracing-otel-javaagent-extension} невозможен:
+ * агент и приложение — разные classloader'ы одной JVM, а wire-контракт передаётся
+ * через {@code CompositeData}/{@code TabularData}. Эта копия и агентская
+ * {@code space.br1440.platform.tracing.otel.javaagent.jmx.observation.JmxObservationWireContract}
+ * должны совпадать по значениям, но проверяются independent-verification тестами
+ * на каждой стороне отдельно: сторона агента строит {@code CompositeType} по своим
+ * константам, сторона декодера проверяет полученный {@code CompositeData} по своим —
+ * синхронное ошибочное переименование в обоих модулях таким образом не проходит
+ * незамеченным через тавтологичный "encode одной стороной — decode другой" тест.
+ */
+public final class JmxObservationWireContract {
+
+    /**
+     * Текущая версия схемы всех шести observation-членов, ожидаемая декодером.
+     *
+     * <p>v2: {@code Sampling}/{@code Scrubbing}/{@code Validation} перешли с sentinel-значений
+     * на presence-дискриминатор — см. агентскую копию контракта.
+     */
+    public static final int SCHEMA_VERSION = 2;
+
+    private JmxObservationWireContract() {
+    }
+
+    // -- Общий каркас (frame) ---------------------------------------------------
+
+    public static final String ITEM_SCHEMA_VERSION = "schemaVersion";
+    public static final String ITEM_CAPTURE_SEQUENCE = "captureSequence";
+    public static final String ITEM_AGENT_INSTANCE_ID = "agentInstanceId";
+    public static final String ITEM_CAPTURE_STARTED_AT = "captureStartedAt";
+    public static final String ITEM_CAPTURE_COMPLETED_AT = "captureCompletedAt";
+
+    // -- Каркас per-owner sub-composite ------------------------------------------
+
+    public static final String ITEM_OWNER_PRESENT = "ownerPresent";
+    public static final String ITEM_OWNER_GENERATION = "ownerGeneration";
+    public static final String ITEM_OWNER_CAPTURED_OFFSET_NANOS = "ownerCapturedOffsetNanos";
+
+    /** Классификация мощности ключей динамической {@code TabularData}-карты. */
+    public enum KeyCardinality {
+        FIXED_ENUM,
+        BOUNDED_ALLOWLIST,
+        DYNAMIC_NOT_EXPORTED
+    }
+
+    /** Семантический тип значения ключа внутри динамической карты. */
+    public enum ValueSemantics {
+        CUMULATIVE,
+        POINT_IN_TIME
+    }
+
+    public record DynamicMapKey(String key, KeyCardinality cardinality, ValueSemantics semantics) {
+    }
+
+    // -- Sampling ---------------------------------------------------------------
+
+    public static final String SAMPLING_COMPOSITE_TYPE_NAME =
+            "space.br1440.platform.tracing.SamplingObservation";
+
+    public static final String SAMPLING_ITEM_SAMPLER_ENABLED = "samplerEnabled";
+    public static final String SAMPLING_ITEM_SAMPLING_RATIO = "samplingRatio";
+    public static final String SAMPLING_ITEM_ROUTE_RATIOS = "routeRatios";
+    public static final String SAMPLING_ITEM_DECISION_COUNTS = "samplerDecisionCounts";
+    public static final String SAMPLING_ITEM_CONFIG_LAST_UPDATED_SOURCE = "samplingConfigLastUpdatedSource";
+
+    /** Presence-дискриминатор владельца {@code samplerDecisionCounts} (см. агентскую копию). */
+    public static final String SAMPLING_ITEM_SAMPLER_OWNER_PRESENT = "samplerOwnerPresent";
+    public static final String SAMPLING_ITEM_SAMPLER_OWNER_GENERATION = "samplerOwnerGeneration";
+    public static final String SAMPLING_ITEM_SAMPLER_OWNER_CAPTURED_OFFSET_NANOS = "samplerOwnerCapturedOffsetNanos";
+
+    // -- Scrubbing ---------------------------------------------------------------
+
