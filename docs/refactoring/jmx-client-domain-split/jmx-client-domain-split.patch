+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+/**
+ * Категория диагностической записи — часть составного ключа {@code JmxDiagnosticKey}.
+ */
+public enum JmxDiagnosticCategory {
+
+    CONTRACT_VIOLATION,
+    EXECUTION_FAILURE
+}
diff --git a/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxDiagnosticKey.java b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxDiagnosticKey.java
new file mode 100644
index 00000000..d1cecee2
--- /dev/null
+++ b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxDiagnosticKey.java
@@ -0,0 +1,21 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+import java.util.Objects;
+
+/**
+ * Составной ключ диагностической записи — произведение трёх закрытых enum, а не строк
+ * от сервера. {@code equals}/{@code hashCode} генерируются компилятором для record,
+ * поэтому dedup в {@link JmxReadStateRegistry} не может тихо сломаться из-за
+ * identity-семантики ключа. Ключ составной, а не просто {@code point}, потому что
+ * иначе невозможно вести отдельные счётчики по {@code kind} и корректную
+ * recovery-семантику одновременно: execution failure не должен быть замолчан
+ * из-за более раннего type mismatch на том же point.
+ */
+public record JmxDiagnosticKey(JmxContractPoint point, JmxDiagnosticCategory category, JmxDiagnosticKind kind) {
+
+    public JmxDiagnosticKey {
+        Objects.requireNonNull(point, "point");
+        Objects.requireNonNull(category, "category");
+        Objects.requireNonNull(kind, "kind");
+    }
+}
diff --git a/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxDiagnosticKind.java b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxDiagnosticKind.java
new file mode 100644
index 00000000..af1309f9
--- /dev/null
+++ b/platform-tracing-spring-boot-autoconfigure/src/main/java/space/br1440/platform/tracing/autoconfigure/diagnostics/jmx/transport/JmxDiagnosticKind.java
@@ -0,0 +1,73 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+/**
+ * Закрытое перечисление стабильных кодов диагностики. Java-имена классов и тексты
+ * исключений схемой не являются — наружу (в {@code tracingStatus} и Micrometer-теги)
+ * попадают только эти значения.
+ *
+ * <p>Первые значения относятся к {@link JmxDiagnosticCategory#CONTRACT_VIOLATION},
+ * последние — к {@link JmxDiagnosticCategory#EXECUTION_FAILURE}.
+ */
+public enum JmxDiagnosticKind {
+
+    // -- ContractViolation --------------------------------------------------
+
+    /** Обязательный член наблюдения или атрибут вернул {@code null}. */
+    NULL_VALUE_FOR_REQUIRED_MEMBER,
+
+    /** Скалярное значение имеет тип, отличный от ожидаемого. */
+    VALUE_TYPE_MISMATCH,
+
+    /** Ключ динамической карты имеет тип, отличный от {@code String}. */
+    MAP_KEY_TYPE_MISMATCH,
+
+    /** Значение элемента динамической карты имеет тип, отличный от ожидаемого. */
+    MAP_VALUE_TYPE_MISMATCH,
+
+    /** Элемент массива имеет тип, отличный от ожидаемого. */
+    ARRAY_ELEMENT_TYPE_MISMATCH,
+
+    /** Значение синтаксически корректного типа не проходит семантический валидатор (например, {@code ratio ∉ [0,1]}). */
+    VALUE_SEMANTICS_VIOLATION,
+
+    /** Ожидаемый атрибут отсутствует в {@code MBeanInfo}. */
+    MISSING_ATTRIBUTE,
+
+    /** Ожидаемая операция отсутствует или сигнатура отличается от заявленной. */
+    OPERATION_SIGNATURE_DRIFT,
+
+    /** {@code schemaVersion} наблюдения не совпадает с ожидаемым декодером. */
+    SCHEMA_VERSION_MISMATCH,
+
+    /** Имя полученного {@code CompositeType} не совпадает с нормативным. */
+    COMPOSITE_TYPE_NAME_MISMATCH,
+
+    /** В observation отсутствует обязательный item. */
+    MISSING_OBSERVATION_ITEM,
+
+    /** {@code ownerGeneration = 0} при {@code ownerPresent = true} — нарушение схемы. */
+    OWNER_GENERATION_INVALID,
+
+    // -- ExecutionFailure -----------------------------------------------------
+
+    /** {@code MBeanException} / {@code RuntimeMBeanException} — отказ внутри реализации MBean. */
+    MBEAN_EXECUTION_FAILURE,
+
+    /** {@code RuntimeErrorException} — {@code Error} внутри реализации MBean. */
+    MBEAN_RUNTIME_ERROR,
+
+    /** {@code SecurityException} на вызове transport. */
+    SECURITY_FAILURE,
+
+    /** {@code IOException} соединения {@code MBeanServerConnection}. */
+    CONNECTOR_FAILURE,
+
+    /** {@code ReflectionException} с cause, не входящим в классифицированный набор. */
+    REFLECTION_UNCLASSIFIED,
+
+    /** {@code RuntimeOperationsException} с cause, отличным от {@code IllegalArgumentException}. */
+    OPERATIONS_EXCEPTION_UNCLASSIFIED,
+
+    /** Проверка {@code isRegistered} завершилась отказом transport (не самим MBean). */
+    REGISTRATION_CHECK_FAILED
+}
