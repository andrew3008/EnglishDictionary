@@ -0,0 +1,181 @@
+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.observation;
+
+import space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.JmxOwnerState;
+import space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport.JmxContractViolationException;
+import space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport.JmxDiagnosticKind;
+import space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport.JmxWireTypeCode;
+
+import javax.management.openmbean.CompositeData;
+import javax.management.openmbean.TabularData;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Общие decode-примитивы для шести {@code *JmxView}: извлечение и типовая проверка item'ов
+ * {@code CompositeData}, декодирование {@code TabularData} со схемой {@code (key STRING,
+ * value LONG)} и построение {@link JmxOwnerState} из presence-дискриминатора.
+ *
+ * <p>Любое несоответствие бросает {@link JmxContractViolationException} — единственный
+ * канал, которым декодер сигналит {@code JmxReadExecutor} о нарушении контракта; сам класс
+ * не перехватывает и не поглощает исключения.
+ */
+public final class JmxObservationCodec {
+
+    private JmxObservationCodec() {
+    }
+
+    /** Проверяет тип raw-значения атрибута верхнего уровня перед доступом к item'ам. */
+    public static CompositeData asComposite(Object raw) {
+        if (!(raw instanceof CompositeData composite)) {
+            throw new JmxContractViolationException(
+                    JmxDiagnosticKind.VALUE_TYPE_MISMATCH, JmxWireTypeCode.COMPOSITE_DATA, actualCodeOf(raw));
+        }
+        return composite;
+    }
+
+    public static void requireSchemaVersion(CompositeData composite) {
+        int version = getInt(composite, JmxObservationWireContract.ITEM_SCHEMA_VERSION);
+        if (version != JmxObservationWireContract.SCHEMA_VERSION) {
+            throw new JmxContractViolationException(
+                    JmxDiagnosticKind.SCHEMA_VERSION_MISMATCH, JmxWireTypeCode.SCALAR_INTEGER, JmxWireTypeCode.SCALAR_INTEGER);
+        }
+    }
+
+    /** Строит presence-состояние владельца из generic frame-item'ов ({@code ownerPresent}/{@code ownerGeneration}). */
+    public static <T> JmxOwnerState<T> ownerState(CompositeData composite, T values) {
+        return ownerState(composite,
+                JmxObservationWireContract.ITEM_OWNER_PRESENT,
+                JmxObservationWireContract.ITEM_OWNER_GENERATION,
+                values);
+    }
+
+    /** То же самое с явно именованными item'ами presence — для доменов с несколькими владельцами на одном уровне. */
+    public static <T> JmxOwnerState<T> ownerState(
+            CompositeData composite, String presentItem, String generationItem, T values) {
+        boolean present = getBoolean(composite, presentItem);
+        long generation = getLong(composite, generationItem);
+        if (present) {
+            if (generation <= 0) {
+                throw new JmxContractViolationException(
+                        JmxDiagnosticKind.OWNER_GENERATION_INVALID, JmxWireTypeCode.SCALAR_LONG, JmxWireTypeCode.SCALAR_LONG);
+            }
+            return new JmxOwnerState.Present<>(values, generation);
+        }
+        return new JmxOwnerState.Absent<>(generation);
+    }
+
+    public static boolean getBoolean(CompositeData composite, String item) {
+        return require(composite, item, Boolean.class, JmxWireTypeCode.SCALAR_BOOLEAN);
+    }
+
+    public static long getLong(CompositeData composite, String item) {
+        return require(composite, item, Long.class, JmxWireTypeCode.SCALAR_LONG);
+    }
+
+    public static int getInt(CompositeData composite, String item) {
+        return require(composite, item, Integer.class, JmxWireTypeCode.SCALAR_INTEGER);
+    }
+
+    public static double getDouble(CompositeData composite, String item) {
+        return require(composite, item, Double.class, JmxWireTypeCode.SCALAR_DOUBLE);
+    }
+
+    public static String getString(CompositeData composite, String item) {
+        return require(composite, item, String.class, JmxWireTypeCode.SCALAR_STRING);
+    }
+
+    public static CompositeData getComposite(CompositeData composite, String item) {
+        return require(composite, item, CompositeData.class, JmxWireTypeCode.COMPOSITE_DATA);
+    }
+
+    /**
+     * Размер {@code TabularData} без декодирования строк — для доменов, где карта классифицирована
+     * как {@code DYNAMIC_NOT_EXPORTED} (например, {@code routeRatios}): наружу отдаётся только
+     * счётчик, ключи (маршруты приложения) в Micrometer-тег или {@code tracingStatus} не попадают.
+     */
+    public static int getTabularSize(CompositeData composite, String item) {
+        return require(composite, item, TabularData.class, JmxWireTypeCode.TABULAR_DATA).size();
+    }
+
+    /** {@code TabularData} со схемой {@code (key STRING, value LONG)} -> неизменяемая {@code Map<String, Long>}. */
+    public static Map<String, Long> getStringLongMap(CompositeData composite, String item) {
+        TabularData table = require(composite, item, TabularData.class, JmxWireTypeCode.TABULAR_DATA);
+        if (table.size() == 0) {
+            return Map.of();
+        }
+        Map<String, Long> result = new LinkedHashMap<>(table.size());
+        for (Object rowObject : table.values()) {
+            CompositeData row = (CompositeData) rowObject;
+            Object keyRaw = row.get("key");
+            Object valueRaw = row.get("value");
+            if (!(keyRaw instanceof String key)) {
+                throw new JmxContractViolationException(
+                        JmxDiagnosticKind.MAP_KEY_TYPE_MISMATCH, JmxWireTypeCode.SCALAR_STRING, actualCodeOf(keyRaw));
+            }
+            if (!(valueRaw instanceof Long value)) {
+                throw new JmxContractViolationException(
+                        JmxDiagnosticKind.MAP_VALUE_TYPE_MISMATCH, JmxWireTypeCode.SCALAR_LONG, actualCodeOf(valueRaw));
+            }
+            result.put(key, value);
+        }
+        return Collections.unmodifiableMap(result);
+    }
+
+    public static List<String> getStringArray(CompositeData composite, String item) {
+        Object raw = composite.get(item);
+        if (raw == null) {
+            throw new JmxContractViolationException(
+                    JmxDiagnosticKind.MISSING_OBSERVATION_ITEM, JmxWireTypeCode.STRING_ARRAY, JmxWireTypeCode.NULL);
+        }
+        if (!(raw instanceof String[] array)) {
+            throw new JmxContractViolationException(
+                    JmxDiagnosticKind.ARRAY_ELEMENT_TYPE_MISMATCH, JmxWireTypeCode.STRING_ARRAY, actualCodeOf(raw));
+        }
+        return Collections.unmodifiableList(Arrays.asList(array));
+    }
+
+    private static <T> T require(CompositeData composite, String item, Class<T> type, JmxWireTypeCode expected) {
+        Object raw = composite.get(item);
+        if (raw == null) {
+            throw new JmxContractViolationException(JmxDiagnosticKind.MISSING_OBSERVATION_ITEM, expected, JmxWireTypeCode.NULL);
+        }
+        if (!type.isInstance(raw)) {
+            throw new JmxContractViolationException(JmxDiagnosticKind.VALUE_TYPE_MISMATCH, expected, actualCodeOf(raw));
+        }
+        return type.cast(raw);
+    }
+
+    private static JmxWireTypeCode actualCodeOf(Object raw) {
+        if (raw == null) {
+            return JmxWireTypeCode.NULL;
+        }
+        if (raw instanceof Long) {
+            return JmxWireTypeCode.SCALAR_LONG;
+        }
+        if (raw instanceof Integer) {
+            return JmxWireTypeCode.SCALAR_INTEGER;
+        }
+        if (raw instanceof Double) {
+            return JmxWireTypeCode.SCALAR_DOUBLE;
+        }
+        if (raw instanceof Boolean) {
+            return JmxWireTypeCode.SCALAR_BOOLEAN;
+        }
+        if (raw instanceof String) {
+            return JmxWireTypeCode.SCALAR_STRING;
+        }
+        if (raw instanceof CompositeData) {
+            return JmxWireTypeCode.COMPOSITE_DATA;
+        }
+        if (raw instanceof TabularData) {
+            return JmxWireTypeCode.TABULAR_DATA;
+        }
+        if (raw instanceof String[]) {
+            return JmxWireTypeCode.STRING_ARRAY;
+        }
+        return JmxWireTypeCode.UNKNOWN;
+    }
+}
