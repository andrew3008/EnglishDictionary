+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+/**
+ * Шесть доменов platform-tracing JMX-контракта. Закрытый enum — используется как
+ * компонент составных ключей диагностики и как тег {@code domain} в Micrometer,
+ * поэтому значения никогда не берутся из строк сервера.
+ */
