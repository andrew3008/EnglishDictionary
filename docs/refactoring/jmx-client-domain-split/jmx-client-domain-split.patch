+                    "space.br1440.platform.tracing.test:type=JmxReadExecutorConcurrencyLinearizationTest,name=" + suffix);
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private static final class FakeDynamicMBean implements DynamicMBean {
