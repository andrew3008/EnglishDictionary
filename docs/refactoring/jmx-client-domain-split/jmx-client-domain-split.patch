+package space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport;
+
+import java.util.Objects;
+
+/**
+ * Отказ выполнения: MBean-реализация или сам транспорт ({@code MBeanServerConnection})
+ * не смогли завершить вызов штатно. В отличие от {@link JmxContractViolation}, здесь
+ * ответ не был получен вовсе, поэтому сообщение исключения сохраняется только для
+ * локального DEBUG-лога и никогда не попадает в {@code tracingStatus} или Micrometer-тег.
+ */
+public record JmxExecutionFailure(JmxContractPoint point, JmxDiagnosticKind kind, String debugMessage) {
+
+    public JmxExecutionFailure {
