@@ -0,0 +1,153 @@
+package space.br1440.platform.tracing.autoconfigure.metrics;
+
+import java.time.Duration;
+import java.util.Optional;
+
+import jakarta.annotation.Nonnull;
+
+import space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.ExportObservation;
+import space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.JmxOwnerState;
+import space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.PlatformTracingJmxClient;
+import space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.ProcessorMetricsObservation;
+import space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.SamplingObservation;
+import space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.ScrubbingObservation;
+import space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.ValidationObservation;
+import space.br1440.platform.tracing.autoconfigure.diagnostics.jmx.transport.JmxMBeanRegistrationState;
+
+import io.micrometer.core.instrument.Gauge;
+import io.micrometer.core.instrument.MeterRegistry;
+import io.micrometer.core.instrument.binder.MeterBinder;
+
+/**
+ * Health-гейджи для всех шести доменных JMX MBean, независимые от конкретной decode-модели
+ * домена: регистрация MBean, читаемость последнего observation, freshness последнего успеха
+ * и presence владельца внутри домена. {@code registered}/{@code readable} различают "MBean не
+ * зарегистрирован" (штатно) от "проверка регистрации не удалась" — оба {@link #registeredValue}
+ * и {@link #ownerPresentValue} возвращают {@code NaN}, а не {@code 0}, когда состояние неизвестно,
+ * иначе Prometheus не отличил бы честный "нет" от "нет данных".
+ *
+ * <p>Шесть доменов — закрытый список, поэтому проекция сделана явными вызовами на каждый домен,
+ * а не через общий интерфейс {@code *JmxView}: у доменов разное число владельцев (0..3), и
+ * искусственная абстракция ради шести похожих, но не идентичных, вызовов не была бы реальной
+ * границей.
+ */
+final class PlatformTracingJmxDomainHealthMetricsBinder implements MeterBinder {
+
+    private static final String REGISTERED_METRIC = "platform.tracing.jmx.domain.registered";
+    private static final String READABLE_METRIC = "platform.tracing.jmx.domain.readable";
+    private static final String FRESHNESS_METRIC = "platform.tracing.jmx.domain.last_success_age_seconds";
+    private static final String OWNER_PRESENT_METRIC = "platform.tracing.jmx.owner.present";
+
+    private final PlatformTracingJmxClient client;
+
+    PlatformTracingJmxDomainHealthMetricsBinder(PlatformTracingJmxClient client) {
+        this.client = client;
+    }
+
+    @Override
+    public void bindTo(@Nonnull MeterRegistry registry) {
+        bindDomain(registry, "sampling",
+                c -> c.sampling().registration(),
+                c -> c.sampling().observation().isPresent(),
+                c -> c.sampling().lastSuccessAge());
+        bindOwner(registry, "sampling", "sampler",
+                c -> c.sampling().observation().map(SamplingObservation::decisionCounts));
+
+        bindDomain(registry, "scrubbing",
+                c -> c.scrubbing().registration(),
+                c -> c.scrubbing().observation().isPresent(),
+                c -> c.scrubbing().lastSuccessAge());
+        bindOwner(registry, "scrubbing", "scrubbing",
+                c -> c.scrubbing().observation().map(ScrubbingObservation::owner));
+
+        bindDomain(registry, "validation",
+                c -> c.validation().registration(),
+                c -> c.validation().observation().isPresent(),
+                c -> c.validation().lastSuccessAge());
+        bindOwner(registry, "validation", "validation",
+                c -> c.validation().observation().map(ValidationObservation::owner));
+
+        bindDomain(registry, "export",
+                c -> c.export().registration(),
+                c -> c.export().observation().isPresent(),
+                c -> c.export().lastSuccessAge());
+        bindOwner(registry, "export", "processor",
+                c -> c.export().observation().map(ExportObservation::processor));
+        bindOwner(registry, "export", "exporter",
+                c -> c.export().observation().map(ExportObservation::exporter));
+
+        bindDomain(registry, "processor_metrics",
+                c -> c.processorMetrics().registration(),
+                c -> c.processorMetrics().observation().isPresent(),
+                c -> c.processorMetrics().lastSuccessAge());
+        bindOwner(registry, "processor_metrics", "watchdog",
+                c -> c.processorMetrics().observation().map(ProcessorMetricsObservation::watchdog));
+        bindOwner(registry, "processor_metrics", "composite",
+                c -> c.processorMetrics().observation().map(ProcessorMetricsObservation::composite));
+        bindOwner(registry, "processor_metrics", "metrics",
+                c -> c.processorMetrics().observation().map(ProcessorMetricsObservation::metrics));
+
+        // Diagnostics — статический синглтон без заменяемого владельца, owner.present не публикуется.
+        bindDomain(registry, "diagnostics",
+                c -> c.diagnostics().registration(),
+                c -> c.diagnostics().observation().isPresent(),
+                c -> c.diagnostics().lastSuccessAge());
+    }
+
+    private void bindDomain(
+            MeterRegistry registry,
+            String domain,
+            DomainFunction<JmxMBeanRegistrationState> registration,
+            DomainFunction<Boolean> readable,
+            DomainFunction<Optional<Duration>> lastSuccessAge) {
+        Gauge.builder(REGISTERED_METRIC, client, c -> registeredValue(registration.apply(c)))
+                .tags("domain", domain)
+                .description("MBean registration tri-state: 1 registered, 0 not registered, NaN unknown")
+                .register(registry);
+
+        Gauge.builder(READABLE_METRIC, client, c -> readable.apply(c) ? 1.0 : 0.0)
+                .tags("domain", domain)
+                .description("1 if the last JMX read for this domain decoded successfully, otherwise 0")
+                .register(registry);
+
+        Gauge.builder(FRESHNESS_METRIC, client, c -> freshnessValue(lastSuccessAge.apply(c)))
+                .tags("domain", domain)
+                .description("Seconds since the last successful decode of this domain, NaN before the first success")
+                .register(registry);
+    }
+
+    private <T> void bindOwner(
+            MeterRegistry registry,
+            String domain,
+            String owner,
+            DomainFunction<Optional<JmxOwnerState<T>>> ownerState) {
+        Gauge.builder(OWNER_PRESENT_METRIC, client, c -> ownerPresentValue(ownerState.apply(c)))
+                .tags("domain", domain, "owner", owner)
+                .description("Owner presence tri-state: 1 present, 0 absent, NaN when the domain itself is unreadable")
+                .register(registry);
+    }
+
+    private static double registeredValue(JmxMBeanRegistrationState state) {
+        return switch (state) {
+            case REGISTERED -> 1.0;
+            case NOT_REGISTERED -> 0.0;
+            case UNKNOWN -> Double.NaN;
+        };
+    }
+
+    private static double freshnessValue(Optional<Duration> lastSuccessAge) {
+        return lastSuccessAge.map(duration -> duration.toNanos() / 1_000_000_000.0).orElse(Double.NaN);
+    }
+
+    private static <T> double ownerPresentValue(Optional<JmxOwnerState<T>> ownerState) {
+        if (ownerState.isEmpty()) {
+            return Double.NaN;
+        }
+        return (ownerState.get() instanceof JmxOwnerState.Present<T>) ? 1.0 : 0.0;
+    }
+
+    @FunctionalInterface
+    private interface DomainFunction<T> {
+        T apply(PlatformTracingJmxClient client);
+    }
+}
